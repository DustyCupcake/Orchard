# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# --- Domain / TLS (Caddy) ---
# The public hostname Orchard will be served on. Caddy automatically
# provisions HTTPS for a real domain. Use your VPS's bare IP for local
# testing before DNS is pointed at it (Caddy will then serve plain HTTP).
DOMAIN=orchard.example.com
DOMAIN_EMAIL=admin@example.com

# --- Database ---
POSTGRES_USER=orchard
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=orchard
# DATABASE_URL is assembled from the POSTGRES_* values above in
# docker-compose.yml; only set it here if running the app outside Compose
# (e.g. `npm run dev` against a local Postgres).
# DATABASE_URL=postgres://orchard:change-me@localhost:5432/orchard

# --- Auth ---
# Long random string used to sign session and magic-link tokens.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-value

# The canonical public URL — used to build magic-link login URLs.
# Should match DOMAIN above (with protocol). Falls back to the
# request's own origin if unset, which is fine for local dev but can
# get the protocol wrong behind a proxy.
APP_URL=https://orchard.example.com

# Name for this deployment's single Community, used only the very
# first time anyone logs in (there's no setup UI yet).
COMMUNITY_NAME="My Community"

# --- Email ---
# Two ways to send: plain SMTP, or Brevo's HTTPS API. If BREVO_API_KEY is
# set, it's used instead of SMTP_* — a plain HTTPS call works from an
# IPv6-only VPS where SMTP relays (whose submission servers are commonly
# IPv4-only even when the rest of the provider's stack is dual-stack) are
# not reachable at all. Get a key from Brevo's dashboard under SMTP & API.
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Orchard <no-reply@example.com>"

# --- Runtime tuning ---
# Node heap cap (MB), keeps the app from starving Postgres on a small VPS.
APP_MAX_OLD_SPACE_MB=384
# Node heap cap (MB) for the `next build` step itself (separate from the
# runtime cap above — the build is a heavier, one-off process). Default
# assumes ~1-2GB swap is available (harden.sh provisions this); raise it if
# the build still OOMs, lower it on a box with less swap.
BUILD_MAX_OLD_SPACE_MB=1536
